    --// TELEPORT ANIMATION
    local function playTeleportAnimation()
        if not isRunning() or not humanoid or humanoid.Health <= 0 then
            return nil
        end

        local track = loadTrack(CONFIG.TeleportAnimation)
        if track then
            track:Play()
        end

        return track
    end

    --// QUANTUM COUNTER
    local function findClosestPlayer()
        local root = getRoot()
        if not root then
            return nil
        end

        local closestPlayer
        local shortestDistanceSquared = CONFIG.CounterDistance * CONFIG.CounterDistance
        local rootPosition = root.Position

        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if not isRunning() then
                return nil
            end

            if otherPlayer ~= player then
                local targetCharacter = otherPlayer.Character
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")

                if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
                    local offset = rootPosition - targetRoot.Position
                    local distanceSquared = offset:Dot(offset)

                    if distanceSquared < shortestDistanceSquared then
                        shortestDistanceSquared = distanceSquared
                        closestPlayer = otherPlayer
                    end
                end
            end
        end

        return closestPlayer
    end

    local function teleportToClosestPlayer()
        local root = getRoot()
        if not isRunning() or not root or not humanoid or humanoid.Health <= 0 then
            return
        end

        local targetPlayer = findClosestPlayer()
        if not targetPlayer or not isRunning() then
            warn("[Quantum Counter] No living player within range.")
            return
        end

        local targetCharacter = targetPlayer.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")

        if not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
            return
        end

        playTeleportAnimation()
        if not isRunning() or not root.Parent or not targetRoot.Parent then
            return
        end

        root.CFrame = targetRoot.CFrame * CONFIG.CounterOffset
    end

    local counterTool = createTool("Quantum Counter")
    connect(counterTool.Activated, teleportToClosestPlayer)

    --// QUANTUM RELOCATION
    local relocationTool = createTool("Quantum Relocation")
    local relocationEquipped = false
    local lastRelocationInput = 0

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = false

    local function teleportToPosition(screenPosition)
        local root = getRoot()
        if not isRunning() or not root or not humanoid or humanoid.Health <= 0 then
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end

        raycastParams.FilterDescendantsInstances = character and { character } or {}

        local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
        local result = Workspace:Raycast(
            ray.Origin,
            ray.Direction * CONFIG.RelocationDistance,
            raycastParams
        )

        if not result or not isRunning() then
            return
        end

        local destination = result.Position + Vector3.new(0, CONFIG.RelocationHeight, 0)
        local lookVector = root.CFrame.LookVector

        playTeleportAnimation()
        if not isRunning() or not root.Parent then
            return
        end

        root.CFrame = CFrame.lookAt(destination, destination + lookVector)
    end

    connect(relocationTool.Equipped, function()
        relocationEquipped = true
    end)

    connect(relocationTool.Unequipped, function()
        relocationEquipped = false
    end)

    connect(UserInputService.InputBegan, function(input, gameProcessed)
        if not relocationEquipped or gameProcessed then
            return
        end

        local inputType = input.UserInputType
        if inputType ~= Enum.UserInputType.MouseButton1
            and inputType ~= Enum.UserInputType.Touch then
            return
        end

        local now = os.clock()
        if now - lastRelocationInput < CONFIG.RelocationCooldown then
            return
        end

        lastRelocationInput = now
        teleportToPosition(input.Position)
    end)

    --// OVERCLOCK
    local overclockTool = createTool("Overclock")
    local overclockActive = false
    local overclockTrack
    local overclockStopTrack
    local movementConnection
    local soundTween
    local elapsedTime = 0
    local moveSpeed = CONFIG.OverclockSpeed
    local trail
    local trailAttachments = {}
    local overclockOriginalAnchored = nil

    local overclockSound = trackInstance(Instance.new("Sound"))
    overclockSound.Name = "SugaBlazOverclockSound"
    overclockSound.SoundId = CONFIG.OverclockSound
    overclockSound.Looped = true
    overclockSound.Volume = 1
    overclockSound.Parent = playerGui

    local function destroyTrail()
        if trail then
            trail:Destroy()
            trail = nil
        end

        for _, attachment in ipairs(trailAttachments) do
            if attachment and attachment.Parent then
                attachment:Destroy()
            end
        end

        table.clear(trailAttachments)
    end

    local function createTrail(root)
        destroyTrail()

        if not root or not root.Parent then
            return
        end

        local attachment0 = Instance.new("Attachment")
        attachment0.Name = "SugaBlazTrailStart"
        attachment0.Parent = root

        local attachment1 = Instance.new("Attachment")
        attachment1.Name = "SugaBlazTrailEnd"
        attachment1.Position = Vector3.new(0, -2, 0)
        attachment1.Parent = root

        trailAttachments = { attachment0, attachment1 }

        trail = Instance.new("Trail")
        trail.Name = "SugaBlazOverclockTrail"
        trail.Attachment0 = attachment0
        trail.Attachment1 = attachment1
        trail.Lifetime = 0.5
        trail.Color = ColorSequence.new(Color3.new(1, 1, 1))
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        })
        trail.Enabled = false
        trail.Parent = root
    end

    local function stopMoving(root)
        if movementConnection then
            disconnectTracked(movementConnection)
            movementConnection = nil
        end

        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
        end

        if trail then
            trail.Enabled = false
        end

        elapsedTime = 0
        moveSpeed = CONFIG.OverclockSpeed
    end

    local function startMoving(root)
        stopMoving(nil)
        elapsedTime = 0
        moveSpeed = CONFIG.OverclockSpeed

        if trail then
            trail.Enabled = true
        end

        movementConnection = connect(RunService.Heartbeat, function(deltaTime)
            if not overclockActive then
                return
            end

            if not root or not root.Parent then
                overclockActive = false
                stopMoving(nil)
                return
            end

            elapsedTime += deltaTime
            if elapsedTime >= CONFIG.OverclockBoostDelay then
                moveSpeed = CONFIG.OverclockBoostSpeed
            end

            root.AssemblyLinearVelocity =
                root.CFrame.LookVector * moveSpeed * CONFIG.OverclockInitialSpeed
        end)
    end

    local function cancelSoundTween()
        if soundTween then
            pcall(function()
                soundTween:Cancel()
            end)
            soundTween = nil
        end
    end

    local function fadeOutSound()
        cancelSoundTween()

        if not overclockSound or not overclockSound.Parent then
            return
        end

        soundTween = TweenService:Create(
            overclockSound,
            TweenInfo.new(CONFIG.OverclockFadeTime),
            { Volume = 0 }
        )

        local currentTween = soundTween
        currentTween:Play()

        currentTween.Completed:Once(function()
            if not isRunning() or overclockActive then
                return
            end

            overclockSound:Stop()
            overclockSound.Volume = 1

            if soundTween == currentTween then
                soundTween = nil
            end
        end)
    end

    local function deactivateOverclock(playStopAnimation, immediateSound)
        overclockActive = false

        local root = getRoot()
        stopMoving(root)

        if root and root.Parent and overclockOriginalAnchored ~= nil then
            root.Anchored = overclockOriginalAnchored
        end
        overclockOriginalAnchored = nil

        if overclockTrack then
            destroyTrack(overclockTrack)
            overclockTrack = nil
        end

        if immediateSound or not isRunning() then
            cancelSoundTween()
            overclockSound:Stop()
            overclockSound.Volume = 1
        else
            fadeOutSound()
        end

        if playStopAnimation and isRunning() and humanoid and humanoid.Health > 0 then
            overclockStopTrack = loadTrack(CONFIG.OverclockStopAnimation)
            if overclockStopTrack then
                overclockStopTrack:Play()
            end
        end
    end

    local function activateOverclock()
        local root = getRoot()
        if not isRunning() or not root or not humanoid or humanoid.Health <= 0 then
            overclockActive = false
            return
        end

        overclockActive = true
        overclockOriginalAnchored = root.Anchored
        if root.Anchored then
            root.Anchored = false
        end

        createTrail(root)

        if overclockTrack then
            destroyTrack(overclockTrack)
        end

        overclockTrack = loadTrack(CONFIG.OverclockRunAnimation)
        if overclockTrack then
            overclockTrack:Play()
        end

        cancelSoundTween()
        overclockSound.Volume = 1
        overclockSound:Play()
        startMoving(root)
    end

    local function toggleOverclock()
        if not isRunning() then
            return
        end

        if overclockActive then
            deactivateOverclock(true, false)
        else
            activateOverclock()
        end
    end

    connect(overclockTool.Activated, toggleOverclock)

    --// ANIMATION OVERRIDES
    local ANIMATION_OVERRIDES = {
        ["rbxassetid://10479335397"] = {
            Id = "rbxassetid://17838006839",
            Time = 0.120,
            Speed = 0.7,
            Duration = 1.2,
        },

        ["rbxassetid://10503381238"] = {
            Id = "rbxassetid://14001963401",
            Time = 0.2,
            Speed = 1,
        },

        ["rbxassetid://10470104242"] = {
            Id = "rbxassetid://17858878027",
            Time = 0.112,
            Speed = 1,
            Delay = 0.2,
        },
    }

    local function onAnimationPlayed(originalTrack, eventCharacter, eventAnimator, eventHumanoid)
        if not isRunning() or not originalTrack or not originalTrack.Animation then
            return
        end

        local settings = ANIMATION_OVERRIDES[originalTrack.Animation.AnimationId]
        if not settings then
            return
        end

        -- Stop the original animation immediately, but only on the character
        -- that raised this event.
        stopAllAnimations(nil, eventHumanoid)

        task.spawn(function()
            if settings.Delay then
                task.wait(settings.Delay)
            end

            if not isRunning()
                or character ~= eventCharacter
                or animator ~= eventAnimator
                or not humanoid
                or humanoid.Health <= 0 then
                return
            end

            local replacementTrack = loadTrack(settings.Id)
            if not replacementTrack or not isRunning() then
                if replacementTrack then
                    destroyTrack(replacementTrack)
                end
                return
            end

            replacementTrack:Play()
            replacementTrack:AdjustSpeed(0)
            replacementTrack.TimePosition = settings.Time
            replacementTrack:AdjustSpeed(settings.Speed)

            if settings.Duration then
                task.delay(settings.Duration, function()
                    if isRunning() then
                        destroyTrack(replacementTrack)
                    end
                end)
            end
        end)
    end

    local function connectAnimationOverrides()
        if not isRunning() or not humanoid then
            return
        end

        disconnectTracked(animationConnection)
        animationConnection = connect(humanoid.AnimationPlayed, function(originalTrack)
            onAnimationPlayed(originalTrack, character, animator, humanoid)
        end)
    end

    --// RESPAWN CLEANUP
    local function resetForRespawn()
        overclockActive = false
        relocationEquipped = false

        local oldRoot = getRoot()
        stopMoving(oldRoot)
        if oldRoot and oldRoot.Parent and overclockOriginalAnchored ~= nil then
            oldRoot.Anchored = overclockOriginalAnchored
        end
        overclockOriginalAnchored = nil

        cancelSoundTween()
        overclockSound:Stop()
        overclockSound.Volume = 1

        if overclockTrack then
            destroyTrack(overclockTrack)
            overclockTrack = nil
        end

        if overclockStopTrack then
            destroyTrack(overclockStopTrack)
            overclockStopTrack = nil
        end

        destroyTrail()
        destroyAllTracks()
        disconnectTracked(animationConnection)
        animationConnection = nil
    end

    --// INITIALIZE
    -- Connect CharacterAdded before waiting for the first character, so a
    -- respawn during startup cannot be missed.
    connect(player.CharacterAdded, function(newCharacter)
        resetForRespawn()

        task.spawn(function()
            if not updateCharacter(newCharacter) or not isRunning() then
                return
            end

            connectAnimationOverrides()
            scheduleUIRefresh()
        end)
    end)

    local initialCharacter = player.Character or player.CharacterAdded:Wait()
    if not isRunning() then
        return
    end

    if not updateCharacter(initialCharacter) then
        if isRunning() then
            warn("[SugaBlaz] Could not initialize the character.")
            StopCharacterScript()
        end
        return
    end

    connectAnimationOverrides()
    updateUltimate()
    updateHotbar()
    connectMoveButtons()

    --// RUN CLEANUP
    onCleanup(function()
        overclockActive = false
        relocationEquipped = false

        local currentRoot = getRoot()
        stopMoving(currentRoot)
        if currentRoot and currentRoot.Parent and overclockOriginalAnchored ~= nil then
            currentRoot.Anchored = overclockOriginalAnchored
        end
        overclockOriginalAnchored = nil

        cancelSoundTween()
        overclockSound:Stop()
        overclockSound.Volume = 1

        destroyTrail()
        destroyAllTracks()
        restoreUI()
    end)

    print("[SugaBlaz] Character script started.")
end

StopCharacterScript = function()
    local run = ActiveRun
    if not run or run.stopping then
        return
    end

    -- Invalidate callbacks before disconnecting anything. This also safely
    -- cancels startup if it is currently yielding in WaitForChild/CharacterAdded.
    run.stopping = true
    ScriptRunning = false
    RunGeneration += 1
    ActiveRun = nil

    for index = #run.connections, 1, -1 do
        local connection = run.connections[index]
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
    table.clear(run.connections)

    for index = #run.cleanupFunctions, 1, -1 do
        pcall(run.cleanupFunctions[index])
    end
    table.clear(run.cleanupFunctions)

    for _, instance in ipairs(run.managedInstances) do
        if instance then
            pcall(function()
                instance:Destroy()
            end)
        end
    end
    table.clear(run.managedInstances)

    print("[SugaBlaz] Character script stopped.")
end

--// CUSTOM BUTTON HOVER / TOUCH DETECTION
local controllerConnections = {}

local function connectController(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(controllerConnections, connection)
    return connection
end

local mouseOverButton = false
local activeTouchPositions = {}

local function isPointInside(guiObject, position)
    local absolutePosition = guiObject.AbsolutePosition
    local absoluteSize = guiObject.AbsoluteSize

    return position.X >= absolutePosition.X
        and position.X <= absolutePosition.X + absoluteSize.X
        and position.Y >= absolutePosition.Y
        and position.Y <= absolutePosition.Y + absoluteSize.Y
end

local function updateIconOverlay()
    local shouldShow = mouseOverButton

    if not shouldShow then
        for _, position in pairs(activeTouchPositions) do
            if isPointInside(button, position) then
                shouldShow = true
                break
            end
        end
    end

    iconOverlay.Visible = shouldShow
end

connectController(button.MouseEnter, function()
    mouseOverButton = true
    updateIconOverlay()
end)

connectController(button.MouseLeave, function()
    mouseOverButton = false
    updateIconOverlay()
end)

connectController(UserInputService.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        activeTouchPositions[input] = Vector2.new(input.Position.X, input.Position.Y)
        updateIconOverlay()
    end
end)

connectController(UserInputService.InputChanged, function(input)
    if input.UserInputType == Enum.UserInputType.Touch and activeTouchPositions[input] then
        activeTouchPositions[input] = Vector2.new(input.Position.X, input.Position.Y)
        updateIconOverlay()
    end
end)

connectController(UserInputService.InputEnded, function(input)
    if activeTouchPositions[input] then
        activeTouchPositions[input] = nil
        updateIconOverlay()
    end
end)

--// CHARACTER BUTTON INTEGRATION
connectController(button.MouseButton1Click, function()
    CharacterSelectionGeneration += 1
    local selectionId = CharacterSelectionGeneration
    local previousCharacter = player.Character

    StopCharacterScript()

    local communicate = previousCharacter:FindFirstChild("Communicate")
    if not communicate or not communicate:IsA("RemoteEvent") then
        warn("[SugaBlaz] Player.Communicate RemoteEvent was not found.")
        return
    end

    local success, errorMessage = pcall(function()
        communicate:FireServer({
            Goal = "Change Character",
            Character = "Cyborg",
        })
    end)

    if not success then
        warn("[SugaBlaz] Character change request failed:", errorMessage)
        return
    end

    task.spawn(function()
        local deadline = os.clock() + 2.5

        while os.clock() < deadline do
            if selectionId ~= CharacterSelectionGeneration then
                return
            end

            if player.Character and player.Character ~= previousCharacter then
                break
            end

            task.wait(0.05)
        end

        if selectionId == CharacterSelectionGeneration and player.Character then
            StartCharacterScript()
        end
    end)
end)

-- Selecting any other character cancels a pending True Genos startup and
-- stops the active feature run. The custom button itself is explicitly skipped.
local boundCharacterButtons = setmetatable({}, { __mode = "k" })

local function bindOtherCharacterButton(instance)
    if not instance:IsA("GuiButton")
        or instance.Name ~= "ClickRegion"
        or instance:IsDescendantOf(trueGenosUI)
        or boundCharacterButtons[instance] then
        return
    end

    boundCharacterButtons[instance] = true

    connectController(instance.Activated, function()
        CharacterSelectionGeneration += 1
        StopCharacterScript()
    end)
end

for _, descendant in ipairs(dropdownScroller:GetDescendants()) do
    bindOtherCharacterButton(descendant)
end

connectController(dropdownScroller.DescendantAdded, bindOtherCharacterButton)

-- Release menu/input listeners if this LocalScript is destroyed or replaced.
connectController(script.Destroying, function()
    CharacterSelectionGeneration += 1
    StopCharacterScript()

    for index = #controllerConnections, 1, -1 do
        local connection = controllerConnections[index]
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end

    table.clear(controllerConnections)
end)

print("[SugaBlaz] Character selector ready. Select True Genos to start.")
