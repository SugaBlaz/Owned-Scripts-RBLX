--// RUN CONTROLLER
local ScriptRunning = false
local RunGeneration = 0
local ActiveRun = nil
local CharacterSelectionGeneration = 0
local StopCharacterScript

local function StartCharacterScript()
    if ScriptRunning then
        warn("[SugaBlaz] Character script is already running.")
        return
    end

    RunGeneration += 1

    local run = {
        id = RunGeneration,
        connections = {},
        cleanupFunctions = {},
        managedInstances = {},
        stopping = false,
    }

    ActiveRun = run
    ScriptRunning = true

    local function isRunning()
        return ScriptRunning
            and ActiveRun == run
            and RunGeneration == run.id
            and not run.stopping
    end

    local function connect(signal, callback)
        if not isRunning() then
            return nil
        end

        local connection = signal:Connect(function(...)
            if isRunning() then
                callback(...)
            end
        end)

        table.insert(run.connections, connection)
        return connection
    end

    local function disconnectTracked(connection)
        if not connection then
            return
        end

        if connection.Connected then
            connection:Disconnect()
        end

        for index = #run.connections, 1, -1 do
            if run.connections[index] == connection then
                table.remove(run.connections, index)
                break
            end
        end
    end

    local function trackInstance(instance)
        table.insert(run.managedInstances, instance)
        return instance
    end

    local function onCleanup(callback)
        table.insert(run.cleanupFunctions, callback)
    end

    --// CONFIGURATION
