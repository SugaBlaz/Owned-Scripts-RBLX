    local uiRefreshQueued = false

    local function scheduleUIRefresh()
        if uiRefreshQueued or not isRunning() then
            return
        end

        uiRefreshQueued = true
        task.defer(function()
            uiRefreshQueued = false
            if not isRunning() then
                return
            end

            updateUltimate()
            updateHotbar()
            connectMoveButtons()
        end)
    end

    connect(playerGui.DescendantAdded, scheduleUIRefresh)

    --// CREATE TOOLS
