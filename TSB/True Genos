    --// CHARACTER STATE
    local character
    local humanoid
    local animator
    local hrp
    local characterRevision = 0
    local animationConnection

    local function getRoot()
        if not character or not character.Parent then
            return nil
        end

        local root = character:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then
            return root
        end

        return nil
    end

    local function updateCharacter(newCharacter)
        if not isRunning() or not newCharacter then
            return false
        end

        characterRevision += 1
        local thisRevision = characterRevision

        character = newCharacter
        humanoid = nil
        animator = nil
        hrp = nil

        local newHumanoid = newCharacter:WaitForChild("Humanoid", CONFIG.CharacterWaitTimeout)
        if not isRunning() or characterRevision ~= thisRevision then
            return false
        end

        if not newHumanoid or not newHumanoid:IsA("Humanoid") then
            warn("[SugaBlaz] Character Humanoid was not found.")
            return false
        end

        local newAnimator = newHumanoid:FindFirstChildOfClass("Animator")
        if not newAnimator then
            newAnimator = newHumanoid:WaitForChild("Animator", 3)
        end

        if not isRunning() or characterRevision ~= thisRevision then
            return false
        end

        if not newAnimator then
            newAnimator = Instance.new("Animator")
            newAnimator.Parent = newHumanoid
        end

        local newRoot = newCharacter:WaitForChild("HumanoidRootPart", CONFIG.CharacterWaitTimeout)
        if not isRunning() or characterRevision ~= thisRevision then
            return false
        end

        if not newRoot or not newRoot:IsA("BasePart") then
            warn("[SugaBlaz] Character HumanoidRootPart was not found.")
            return false
        end

        humanoid = newHumanoid
        animator = newAnimator
        hrp = newRoot
        return true
    end

    --// ANIMATION TRACK MANAGEMENT
    local animationTracks = {}

    local function destroyTrack(track)
        if not track then
            return
        end

        animationTracks[track] = nil

        pcall(function()
            track:Stop(0)
            track:Destroy()
        end)
    end

    local function destroyAllTracks()
        for track in pairs(animationTracks) do
            destroyTrack(track)
        end
    end

    local function loadTrack(animationId)
        if not isRunning() or not animator then
            return nil
        end

        local animation = Instance.new("Animation")
        animation.AnimationId = animationId

        local success, trackOrError = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if not success then
            warn("[SugaBlaz] Could not load animation:", animationId, trackOrError)
            return nil
        end

        local track = trackOrError
        animationTracks[track] = true

        -- Remove completed tracks from the registry so repeated moves do not
        -- leave an ever-growing list of stopped AnimationTracks.
        track.Stopped:Once(function()
            animationTracks[track] = nil
            pcall(function()
                track:Destroy()
            end)
        end)

        return track
    end

    local function stopAllAnimations(exceptTrack, targetHumanoid)
        local target = targetHumanoid or humanoid
        if not target then
            return
        end

        for _, track in ipairs(target:GetPlayingAnimationTracks()) do
            if track ~= exceptTrack then
                pcall(function()
                    track:Stop(0)
                end)
            end
        end
    end

    --// UI VALUE RESTORATION
    local savedUIValues = setmetatable({}, { __mode = "k" })

    local function setUIProperty(instance, property, value)
        if not instance then
            return
        end

        local saved = savedUIValues[instance]
        if not saved then
            saved = {}
            savedUIValues[instance] = saved
        end

        if saved[property] == nil then
            local success, originalValue = pcall(function()
                return instance[property]
            end)

            if success then
                saved[property] = originalValue
            end
        end

        pcall(function()
            instance[property] = value
        end)
    end

    local function restoreUI()
        for instance, properties in pairs(savedUIValues) do
            if instance and instance.Parent then
                for property, originalValue in pairs(properties) do
                    pcall(function()
                        instance[property] = originalValue
                    end)
                end
            end
        end

        table.clear(savedUIValues)
    end

